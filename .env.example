# Copy this to .env and fill it in. .env is gitignored -- never commit it.

# From the Discord Developer Portal -> your application -> Bot -> Reset Token.
# Treat it like a password: anyone holding it IS your bot.
DISCORD_TOKEN=

# Your own Discord user id (Developer Mode on -> right-click yourself -> Copy
# User ID). This account runs unjailed, approves everyone else, and is the only
# one that can manage the server.
NOVA_OWNER_ID=
NOVA_OWNER_NAME=Uno
NOVA_OWNER_HANDLE=UnoRfl

# Your server's id, used by list_roles.py during setup.
NOVA_GUILD_ID=

# --- who may do what -------------------------------------------------------
# Role IDs, comma separated. Run list_roles.py to find them. IDs, not names:
# a name can be renamed or duplicated by anyone with Manage Roles.

# May run /promptnova, but every prompt is sent to you for approval first.
NOVA_ASK_ROLES=
# May run /promptnova immediately, still sandboxed. Empty is a fine answer.
NOVA_TRUSTED_ROLES=
# May hold a conversation with her at all. Empty means you alone.
NOVA_CHAT_ROLES=

# --- limits ----------------------------------------------------------------
NOVA_DAILY_CAP=6          # runs per person per day
NOVA_COOLDOWN=90          # seconds between one person's requests
NOVA_GLOBAL_CAP=40        # runs across everyone, per day
NOVA_JOB_TIMEOUT=600      # seconds a single job may run
NOVA_SESSION_IDLE=3600    # silence before a conversation is finished

# --- models ----------------------------------------------------------------
# You get the good one; everyone else gets the cheap one.
NOVA_OWNER_MODEL=claude-opus-5
NOVA_GUEST_MODEL=claude-haiku-4-5-20251001

# Where she is allowed to work when YOU ask. Guests never see this folder.
NOVA_WORKDIR=
